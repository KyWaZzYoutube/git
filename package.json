{
  "name": "premiere-immo-demo-video",
  "version": "1.0.0",
  "description": "Vidéos motion design Première Immo (compositions HTML/GSAP rendues image par image, bande-son synthétisée).",
  "scripts": {
    "preview": "npx http-server . -p 8080 -c-1 -o /compositions/google-ads/",
    "stills": "node scripts/render.mjs stills",
    "build:google-ads": "./scripts/build.sh google-ads",
    "build:demo": "./scripts/build.sh demo",
    "landing": "npx http-server landing -p 8080 -c-1 -o /",
    "landing:shots": "node scripts/landing_preview.mjs shots && node scripts/landing_preview.mjs shots --mobile",
    "landing:video": "node scripts/landing_preview.mjs video"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyWaZzYoutube/git.git"
  },
